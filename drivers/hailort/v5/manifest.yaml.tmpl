version: v1alpha1
metadata:
  name: hailort-v5
  version: "{{ .VERSION }}"
  author: hailo.ai team
  description: |
    [{{ .TIER }}] Driver (hailo1x_pci) for the Hailo-10 and Hailo-15 family of AI accelerators (Hailo-10H, Hailo-15H, Hailo-15L) over PCIe and M.2. Based on hailort-drivers v5.x. Ships Hailo-10H firmware; Hailo-15 firmware must be side-loaded.
  compatibility:
    talos:
      version: ">= v1.9.0"
